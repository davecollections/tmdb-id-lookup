{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davecollections.github.io/tmdb-id-lookup/schemas/entity-title-count-progress.schema.json",
  "title": "Typed entity title-count progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_semantic_version",
    "month",
    "dimension",
    "target_fingerprint",
    "run_id",
    "observed_at",
    "results"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "parser_semantic_version": { "const": "1.0.0" },
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "dimension": {
      "enum": ["company-movie", "company-series", "network-series"]
    },
    "target_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "slice_index": { "type": ["integer", "null"], "minimum": 0 },
    "total_slices": { "type": ["integer", "null"], "minimum": 1 },
    "request_usage": { "type": ["object", "null"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": { "enum": ["positive", "zero", "failed", "unavailable"] },
          "count": { "type": ["integer", "null"], "minimum": 0 },
          "error_code": { "type": "string" },
          "error": { "type": "string" },
          "unavailable_reason": {
            "enum": ["entity_not_found_confirmed", "entity_removed_and_not_found"]
          },
          "attempt_window": {
            "oneOf": [
              {
                "type": "array",
                "prefixItems": [
                  { "type": "string", "format": "date-time" },
                  { "const": 1 }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "array",
                "prefixItems": [
                  { "type": "string", "format": "date-time" },
                  { "type": "string", "format": "date-time" },
                  { "type": "integer", "minimum": 2 }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "observed_at"],
              "properties": {
                "kind": { "enum": ["details_404", "export_absence"] },
                "observed_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "positive" } } },
            "then": {
              "required": ["count"],
              "properties": { "count": { "type": "integer", "minimum": 1 } }
            }
          },
          {
            "if": { "properties": { "status": { "const": "zero" } } },
            "then": {
              "required": ["count"],
              "properties": { "count": { "const": 0 } }
            }
          },
          {
            "if": { "properties": { "status": { "const": "failed" } } },
            "then": {
              "required": ["count", "error_code", "error"],
              "properties": { "count": { "const": null } }
            }
          },
          {
            "if": { "properties": { "status": { "const": "unavailable" } } },
            "then": {
              "required": ["count", "unavailable_reason", "evidence"],
              "properties": { "count": { "const": null } }
            }
          }
        ]
      }
    }
  }
}
