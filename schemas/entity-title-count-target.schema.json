{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davecollections.github.io/tmdb-id-lookup/schemas/entity-title-count-target.schema.json",
  "title": "Frozen entity title-count target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_semantic_version",
    "entity_type",
    "month",
    "export_date",
    "target_fingerprint",
    "total_ids",
    "created_at",
    "ids"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "parser_semantic_version": { "const": "1.0.0" },
    "entity_type": { "enum": ["company", "network"] },
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "export_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{2}_\\d{2}_\\d{4}$"
    },
    "target_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "total_ids": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "uniqueItems": true
    }
  }
}
