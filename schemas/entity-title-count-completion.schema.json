{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davecollections.github.io/tmdb-id-lookup/schemas/entity-title-count-completion.schema.json",
  "title": "Entity title-count completion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_semantic_version",
    "status",
    "month",
    "published_at",
    "stale_after",
    "targets",
    "dimensions",
    "sidecar"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "parser_semantic_version": { "const": "1.0.0" },
    "status": { "const": "complete" },
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "published_at": { "type": "string", "format": "date-time" },
    "stale_after": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company-movie", "company-series", "network-series"],
      "properties": {
        "company-movie": { "type": "string", "format": "date-time" },
        "company-series": { "type": "string", "format": "date-time" },
        "network-series": { "type": "string", "format": "date-time" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companies", "networks"],
      "properties": {
        "companies": { "$ref": "#/$defs/target" },
        "networks": { "$ref": "#/$defs/target" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company-movie", "company-series", "network-series"],
      "properties": {
        "company-movie": { "$ref": "#/$defs/summary" },
        "company-series": { "$ref": "#/$defs/summary" },
        "network-series": { "$ref": "#/$defs/summary" }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "raw_bytes",
        "gzip_bytes",
        "observation_entries",
        "company_sparse_overrides",
        "network_sparse_overrides",
        "network_sparse_override_limit"
      ],
      "properties": {
        "path": { "const": "data/entity-title-counts.min.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "raw_bytes": { "type": "integer", "minimum": 0, "maximum": 5242880 },
        "gzip_bytes": { "type": "integer", "minimum": 0, "maximum": 1310720 },
        "observation_entries": { "type": "integer", "minimum": 0, "maximum": 512 },
        "company_sparse_overrides": { "type": "integer", "minimum": 0, "maximum": 25000 },
        "network_sparse_overrides": { "type": "integer", "minimum": 0 },
        "network_sparse_override_limit": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "total_ids", "export_date"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "total_ids": { "type": "integer", "minimum": 0 },
        "export_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{2}_\\d{2}_\\d{4}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pending", "positive", "zero", "failed", "unavailable"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "pending": { "const": 0 },
        "positive": { "type": "integer", "minimum": 0 },
        "zero": { "type": "integer", "minimum": 0 },
        "failed": { "const": 0 },
        "unavailable": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
