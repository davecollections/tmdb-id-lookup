{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davecollections.github.io/tmdb-id-lookup/schemas/tmdb-request-reservation.schema.json",
  "title": "TMDB request reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reservation_id",
    "utc_date",
    "workflow",
    "run_id",
    "run_attempt",
    "job",
    "planned_month",
    "planned_utc_date",
    "bucket",
    "allocations",
    "bindings",
    "total_allowance",
    "projected_daily_total",
    "preferred_daily_limit",
    "absolute_daily_limit",
    "fixed_genre_commitment",
    "protected_audit_commitment",
    "protected_repair_commitment",
    "preferred_override_used",
    "override_reason",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "reservation_id": { "type": "string", "minLength": 1 },
    "utc_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "workflow": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "run_attempt": { "type": "string", "minLength": 1 },
    "job": { "type": "string", "minLength": 1 },
    "planned_month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "planned_utc_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "bucket": { "enum": ["general", "audit", "repair"] },
    "allocations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_class", "target_dimension", "approved_allowance"],
        "properties": {
          "request_class": { "type": "string", "minLength": 1 },
          "target_dimension": { "type": "string", "minLength": 1 },
          "approved_allowance": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "total_allowance": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "projected_daily_total": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "preferred_daily_limit": { "const": 90000 },
    "absolute_daily_limit": { "const": 100000 },
    "fixed_genre_commitment": { "const": 36 },
    "protected_audit_commitment": { "const": 14 },
    "protected_repair_commitment": { "const": 4000 },
    "preferred_override_used": { "type": "boolean" },
    "override_reason": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
