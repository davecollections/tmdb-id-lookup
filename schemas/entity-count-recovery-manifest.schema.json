{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davecollections.github.io/tmdb-id-lookup/schemas/entity-count-recovery-manifest.schema.json",
  "title": "Typed entity-count recovery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "artifact_name",
    "repository",
    "base_commit",
    "created_at",
    "workflow",
    "workflow_file",
    "event",
    "mode",
    "head_ref",
    "head_sha",
    "run_id",
    "run_attempt",
    "writer_job",
    "workload",
    "planned_month",
    "planned_utc_date",
    "reservation",
    "target",
    "progress",
    "legacy",
    "payload_inventory_sha256",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "ready" },
    "artifact_name": {
      "type": "string",
      "pattern": "^maintenance-recovery-v1-[A-Za-z0-9._-]+-[A-Za-z0-9._-]+-(collect-company-movie|collect-company-series|collect-network-series|repair-company|repair-network)$"
    },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "workflow": { "type": "string", "minLength": 1 },
    "workflow_file": {
      "type": "string",
      "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"
    },
    "event": { "enum": ["schedule", "workflow_dispatch", "workflow_run"] },
    "mode": { "const": "collect" },
    "head_ref": { "const": "refs/heads/main" },
    "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_attempt": { "type": "string", "minLength": 1 },
    "writer_job": {
      "enum": [
        "collect-company-movie",
        "collect-company-series",
        "collect-network-series",
        "repair-company",
        "repair-network"
      ]
    },
    "workload": {
      "enum": ["company-movie", "company-series", "network-series", "company-repair", "network-repair"]
    },
    "planned_month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "planned_utc_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "path", "sha256", "allocation_key", "request_class",
        "target_dimension", "allowance", "attempts_used", "unused_allowance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "allocation_key": { "type": "string", "minLength": 1 },
        "request_class": { "type": "string", "minLength": 1 },
        "target_dimension": { "enum": ["company-movie", "company-series", "network-series"] },
        "allowance": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "attempts_used": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "unused_allowance": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "path", "fingerprint", "schema_version", "parser_semantic_version"],
      "properties": {
        "entity_type": { "enum": ["company", "network"] },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "schema_version": { "const": 1 },
        "parser_semantic_version": { "const": "1.0.0" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "run_id", "observed_at", "slice_index", "total_slices", "result_count"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "run_id": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "slice_index": { "type": ["integer", "null"], "minimum": 0 },
        "total_slices": { "type": ["integer", "null"], "minimum": 1 },
        "result_count": { "type": "integer", "minimum": 1 }
      }
    },
    "legacy": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "observed_at"],
          "properties": {
            "paths": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/repositoryPath" }
            },
            "observed_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "payload_inventory_sha256": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "bytes", "sha256", "base_sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/repositoryPath" },
          "role": { "enum": ["usage", "typed-progress", "legacy"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "base_sha256": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
